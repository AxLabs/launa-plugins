{
  "name": "launa",
  "version": "0.1.3",
  "description": "Sign in to Launa to manage APIs, endpoint pricing, domains, discovery, analytics, and settlements in your chosen Sandbox or Live environment.",
  "author": {
    "name": "AxLabs GmbH"
  },
  "homepage": "https://launa.io",
  "repository": "https://github.com/AxLabs/launa-plugins",
  "license": "Apache-2.0",
  "keywords": [
    "launa",
    "x402",
    "payments",
    "mcp"
  ],
  "logo": "assets/icon.svg",
  "mcpServers": {
    "launa": {
      "url": "https://mcp.launa.io/mcp",
      "auth": {
        "CLIENT_ID": "launa-cursor",
        "scopes": [
          "apis:read",
          "apis:write",
          "endpoints:read",
          "endpoints:write",
          "domains:read",
          "domains:write",
          "stats:read",
          "settlements:read",
          "openapi:read",
          "billing:read",
          "income:read",
          "sandbox:wallet"
        ]
      }
    }
  },
  "skills": [
    "skills/setup",
    "skills/wrap-api",
    "skills/price-endpoints",
    "skills/discovery",
    "skills/custom-domain",
    "skills/cors",
    "skills/sandbox",
    "skills/analytics"
  ],
  "commands": [
    "commands/wrap.md",
    "commands/price.md",
    "commands/discover.md",
    "commands/domain.md",
    "commands/cors.md"
  ]
}
